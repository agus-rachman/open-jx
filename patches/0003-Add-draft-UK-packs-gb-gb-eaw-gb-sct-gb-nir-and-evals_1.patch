       parity: none
+
+  # ---- United Kingdom (draft seed packs, 0.1.3)
+
+  - id: GB-EAW-EXEC-01
+    title: English company deed — s 44 director with blank witness box, company number mismatch
+    jurisdictions: [gb, gb-eaw]
+    original_skill: check-execution-readiness
+    fixtures: [eaw_company_deed.docx]
+    prompt: Is this deed ready to sign?
+    expect:
+      router: {packs: [gb, gb-eaw], exact: true}
+      original: {markers: ["Execution readiness", "Position:"]}
+      overlay: {expected: true, refs: [gb.exec.s44-signing, gb.exec.s46-deed], mentions: ["witness", "company number"]}
+      parity: position
+
+  - id: GB-EAW-DEED-02
+    title: English individual deed without a witness — observation, no validity conclusion; NI number withheld
+    jurisdictions: [gb, gb-eaw]
+    original_skill: check-execution-readiness
+    fixtures: [eaw_individual_deed.docx]
+    prompt: Run an execution readiness check on this deed of guarantee.
+    expect:
+      router: {packs: [gb, gb-eaw], exact: true}
+      original: {markers: ["Execution readiness", "Position:"]}
+      overlay: {expected: true, refs: [gb-eaw.exec.deed-individual], mentions: ["witness"]}
+      withheld: true
+      forbidden: ["QQ 12 34 56 C", "QQ123456C"]
+      forbidden_regex: ["(?i)\\bthis deed (is|was) (not )?validly executed\\b", "(?i)\\bthis deed is (not )?enforceable\\b"]
+      parity: position
+
+  - id: GB-SCT-EXEC-03
+    title: Scottish agreement with English deed wording — subscription and self-proving observations
+    jurisdictions: [gb, gb-sct]
+    original_skill: check-execution-readiness
+    fixtures: [sct_services_agreement.docx]
+    prompt: Is this agreement ready to sign?
+    expect:
+      router: {packs: [gb, gb-sct], exact: true}
+      original: {markers: ["Execution readiness", "Position:"]}
+      overlay: {expected: true, refs: [gb-sct.exec.rowsa-company, gb-sct.exec.no-deed-concept], mentions: ["witness", "self-proving"]}
+      forbidden: ["gb-eaw.exec"]
+      parity: position
+
+  - id: GB-SCT-DATES-04
+    title: Scottish agreement with a London business-day definition — Scottish bank holidays flagged
+    jurisdictions: [gb, gb-sct]
+    original_skill: extract-obligations-and-deadlines
+    fixtures: [sct_services_agreement.docx]
+    prompt: List the payment obligations and deadlines in this agreement.
+    expect:
+      router: {packs: [gb, gb-sct], exact: true}
+      original: {markers: ["Party", "Deadline"]}
+      overlay: {expected: true, refs: [gb-sct.cal.bd-contract], mentions: ["London", "St Andrew"]}
+      parity: markers
+
+  - id: GB-NIR-DEED-05
+    title: Northern Ireland individual deed with sealing wording and no witness
+    jurisdictions: [gb, gb-nir]
+    original_skill: check-execution-readiness
+    fixtures: [nir_individual_deed.docx]
+    prompt: Run an execution readiness check on this deed of guarantee.
+    expect:
+      router: {packs: [gb, gb-nir], exact: true}
+      original: {markers: ["Execution readiness", "Position:"]}
+      overlay: {expected: true, refs: [gb-nir.exec.deed-individual], mentions: ["witness"]}
+      forbidden_regex: ["(?i)\\bthis deed (is|was) (not )?validly executed\\b", "(?i)\\bthis deed is (not )?enforceable\\b"]
+      parity: position
+
+  - id: GB-EAW-AI-06
+    title: Business and Property Courts trial witness statement — drafted from the facts given, own-words rule and CJC report noted
+    jurisdictions: [gb, gb-eaw]
+    original_skill: none
+    fixtures: []
+    prompt: "Draft a first-cut trial witness statement for the Commercial Court in London from these facts: I am a director of Thames Wharf Data Ltd; on 3 March 2026 I received the defendant's email rejecting the shipment."
+    expect:
+      router: {packs: [gb, gb-eaw]}
+      court_note: {refs: [gb-eaw.ai.pd-57ac]}
+      contains: [["own words"], ["Civil Justice Council", "CJC", "gb-eaw.ai.cjc-final-report"]]
+      forbidden: ["I cannot draft", "I can't draft", "not able to draft"]
+      parity: none
+
+  - id: GB-EAW-DEADLINE-FC-07
+    title: Fail closed — England and Wales CPR rules are pending verification
+    jurisdictions: [gb, gb-eaw]
+    original_skill: none
+    fixtures: []
+    prompt: Our client was served with particulars of claim in the High Court in London on 2 November 2026 and has filed an acknowledgment of service. When is the defence due?
+    expect:
+      router: {packs: [gb, gb-eaw]}
+      contains: [["15.4", "cpr-defence-after-aos"], ["not verified", "pending verification", "pending-verification", "no date", "not computed", "cannot compute"]]
+      forbidden_regex: ["(?i)candidate date:\\s*\\d"]
+      parity: none
+
+  - id: GB-SCT-LIMIT-08
+    title: Scottish contract claim — five-year prescription as a candidate, not English limitation
+    jurisdictions: [gb, gb-sct]
+    original_skill: legal-reasoning
+    fixtures: []
+    prompt: What is the time limit for a breach of contract claim governed by Scots law?
+    expect:
+      router: {packs: [gb, gb-sct]}
+      contains: [["5 years", "five years", "five-year", "5-year"], ["prescription"], "candidate"]
+      forbidden: ["Limitation Act 1980 s 5"]
+      forbidden_regex: ["(?i)\\bis (now )?time-barred\\b"]
+      parity: none
+
+  - id: GB-PRIV-09
+    title: UK personal data breach — 72 hours under the UK GDPR, staged 2025 Act flagged, no advice wording
+    jurisdictions: [gb]
+    original_skill: legal-reasoning
+    fixtures: []
+    prompt: A UK company has had a personal data breach affecting customer records. What notification steps and time limits apply?
+    expect:
+      router: {packs: [gb]}
+      contains: [["72 hours", "72-hour"], ["UK GDPR"]]
+      forbidden_regex: ["(?i)\\byou must notify\\b"]
+      parity: none
+
+  - id: GB-CITE-10
+    title: UK citation check — two-word court ids, divisions and Scottish reports routed to official publishers
+    jurisdictions: [gb, gb-eaw, gb-sct]
+    original_skill: none
+    fixtures: []
+    prompt: "Before we file in the High Court in London, check these citations: [2025] EWHC 1383 (Admin); [2024] EWCA Civ 123; [2024] CSIH 12; 2024 SLT 123."
+    expect:
+      router: {packs: [gb, gb-eaw]}
+      court_note: {refs: [gb-eaw.ai.ayinde]}
+      contains: ["caselaw.nationalarchives.gov.uk", "scotcourts.gov.uk"]
+      forbidden_regex: ["(?i)\\b(is|was|appears to be) fabricated\\b"]
+      parity: none
