+  authority: Requirements of Writing (Scotland) Act 1995 s 6; Land Registration etc. (Scotland) Act 2012
+  source_url: https://www.ros.gov.uk/
+  status: in-force
+  verified: null
+  verified_by: null
+  note: pinpoint to be confirmed against legislation.gov.uk
